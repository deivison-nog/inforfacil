<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".ui.module.ModuleDetailActivity">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsModule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/azul_principal"
        app:tabTextColor="@color/texto_secundario"
        app:tabSelectedTextColor="@color/azul_principal">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aprender" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Praticar" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progresso" />

    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/sectionLearn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerLearn"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLearnCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                tools:text="1/3" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/sectionPractice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPracticeCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_secundario"
                    tools:text="Atividade 1/3" />

                <TextView
                    android:id="@+id/tvPracticeQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"
                    tools:text="Pergunta da atividade" />

                <LinearLayout
                    android:id="@+id/groupOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="8dp"
                        android:minHeight="48dp"
                        app:iconGravity="textStart"
                        tools:text="Opção 1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="8dp"
                        android:minHeight="48dp"
                        app:iconGravity="textStart"
                        tools:text="Opção 2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption3"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="8dp"
                        android:minHeight="48dp"
                        app:iconGravity="textStart"
                        tools:text="Opção 3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption4"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:minHeight="48dp"
                        app:iconGravity="textStart"
                        tools:text="Opção 4" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/groupDragDrop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Itens para arrastar"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <LinearLayout
                        android:id="@+id/layoutDragItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Destinos"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <LinearLayout
                        android:id="@+id/layoutDropTargets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPracticeFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Correto!" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckPractice"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="Verificar"
                    app:backgroundTint="@color/azul_principal" />

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/sectionProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvProgressStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                tools:text="☆☆☆" />

            <TextView
                android:id="@+id/tvProgressSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/texto_principal"
                tools:text="0% concluído" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryModule"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="Tentar novamente"
                app:backgroundTint="@color/verde_progresso" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
